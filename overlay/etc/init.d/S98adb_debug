#!/bin/sh
#
# Отладочный скрипт: держит adb (Android Debug Bridge) поверх USB-гаджета
# ПОСТОЯННО (сторож), пока на SD есть маркер /mnt/sd_0/enable_adb.
#
# Зачем сторож: раньше скрипт поднимал adb один раз (~150 с после загрузки) и
# замолкал — если гаджет/adbd позже сбрасывались, adb пропадал и вернуть его
# можно было только перезагрузкой плеера. Теперь раз в несколько секунд
# проверяем: если `functions` не `adb` или adbd не запущен — перенастраиваем
# гаджет (в той же последовательности, что K90adb: сначала enable=0, потом
# functions/enable=1) и перезапускаем adbd.
#
# Отключить: удалить маркер /mnt/sd_0/enable_adb (или создать
# /mnt/sd_0/disable_adb — сторож приостановится, чтобы можно было отдать карту
# как накопитель).
#
# Отчёт — /mnt/sd_0/adb_boot.log (и /tmp/adb_boot.log); вывод adbd —
# /mnt/sd_0/adbd.log (или /tmp/adbd.log).

GADGET=/sys/class/android_usb/android0
MARKER=/mnt/sd_0/enable_adb
STOP=/mnt/sd_0/disable_adb
LOG1=/mnt/sd_0/adb_boot.log
LOG2=/tmp/adb_boot.log
PERIOD=8

log() {
    echo "$(date '+%H:%M:%S') $*" >>"$LOG1" 2>/dev/null
    echo "$*" >>"$LOG2" 2>/dev/null
}

adbd_pid() {
    for p in /proc/[0-9]*; do
        if [ "$(cat "$p/comm" 2>/dev/null)" = "adbd" ]; then
            echo "${p#/proc/}"
            return 0
        fi
    done
    return 1
}

report() {
    log "--- $1"
    for f in enable state functions idVendor idProduct; do
        log "  $f = $(cat $GADGET/$f 2>/dev/null)"
    done
    log "  adbd pid: $(adbd_pid)"
}

try_functions() {
    funcs="$1"
    echo 0 >"$GADGET/enable" 2>/dev/null
    sleep 1
    echo 18d1 >"$GADGET/idVendor" 2>/dev/null
    echo 0d02 >"$GADGET/idProduct" 2>/dev/null
    echo "$funcs" >"$GADGET/functions" 2>/dev/null
    echo 1 >"$GADGET/enable" 2>/dev/null
    sleep 2
    got=$(cat "$GADGET/functions" 2>/dev/null)
    log "try '$funcs' -> functions='$got' state='$(cat $GADGET/state 2>/dev/null)'"
    [ "$got" = "$funcs" ]
}

start_adbd() {
    if ! adbd_pid >/dev/null; then
        if [ -d /mnt/sd_0 ]; then
            adbd_log=/mnt/sd_0/adbd.log
        else
            adbd_log=/tmp/adbd.log
        fi
        /sbin/adbd >>"$adbd_log" 2>&1 &
        sleep 1
        log "adbd запущен, pid $(adbd_pid), лог $adbd_log"
    fi
}

watchdog() {
    report "boot"
    while :; do
        if [ -f "$STOP" ]; then
            sleep "$PERIOD"
            continue
        fi
        if [ ! -f "$MARKER" ]; then
            sleep "$PERIOD"
            continue
        fi
        fn=$(cat "$GADGET/functions" 2>/dev/null)
        if [ "$fn" = "adb" ] && adbd_pid >/dev/null; then
            sleep "$PERIOD"
            continue
        fi
        if try_functions adb; then
            start_adbd
            report "watchdog: adb восстановлен"
        fi
        sleep "$PERIOD"
    done
}

case "$1" in
    start)
        watchdog &
        ;;
    stop)
        /sbin/kill_adbserver.sh >/dev/null 2>&1 &
        ;;
esac

exit 0
